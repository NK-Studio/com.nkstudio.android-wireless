/* ---------- 레이아웃 ---------- */
.aw-root {
    flex-grow: 1;
}

.aw-root > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding: 8px 10px 12px 10px;
}

.aw-section {
    margin-bottom: 10px;
    padding: 8px 10px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    background-color: var(--unity-colors-helpbox-background);
}

.aw-section-title {
    -unity-font-style: bold;
    font-size: 13px;
    margin-bottom: 4px;
    padding: 0;
}

.aw-row {
    flex-direction: row;
    align-items: center;
}

.aw-row--between {
    justify-content: space-between;
}

.aw-row--end {
    justify-content: flex-end;
}

.aw-grow {
    flex-grow: 1;
    flex-shrink: 1;
}

/* ---------- 텍스트 ---------- */
.aw-mono {
    font-size: 11px;
    white-space: normal;
}

.aw-muted {
    color: var(--unity-colors-label-text-focus);
    opacity: 0.7;
}

.aw-hint {
    font-size: 11px;
    opacity: 0.6;
    white-space: normal;
    margin-top: 2px;
}

.aw-help {
    white-space: normal;
    margin-bottom: 8px;
}

/* ---------- 버튼 ---------- */
.aw-button-primary {
    height: 28px;
    margin-top: 8px;
    -unity-font-style: bold;
}

.aw-button-small {
    height: 18px;
    font-size: 11px;
    padding: 0 8px;
}

/* ---------- 탭 ---------- */
.aw-tabs {
    flex-direction: row;
    margin-bottom: -1px;
}

.aw-tab {
    flex-grow: 1;
    height: 26px;
    margin: 0;
    border-radius: 6px 6px 0 0;
    border-bottom-width: 0;
    opacity: 0.6;
}

.aw-tab--selected {
    opacity: 1;
    -unity-font-style: bold;
    background-color: var(--unity-colors-helpbox-background);
}

.aw-page {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
}

.aw-page--hidden {
    display: none;
}

/* ---------- QR ---------- */
.aw-qr-frame {
    align-self: center;
    width: 240px;
    height: 240px;
    border-radius: 8px;
    background-color: rgb(255, 255, 255);
    align-items: center;
    justify-content: center;
}

.aw-qr {
    width: 232px;
    height: 232px;
    -unity-background-scale-mode: scale-to-fit;
}

.aw-qr-placeholder {
    position: absolute;
    color: rgb(120, 120, 120);
    -unity-text-align: middle-center;
}

/* ---------- 상태 ---------- */
.aw-status {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
    padding: 8px 10px;
    border-radius: 6px;
    border-width: 1px;
}

.aw-status-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 8px;
    flex-shrink: 0;
}

.aw-status-text {
    white-space: normal;
    flex-shrink: 1;
    padding: 0;
    margin: 0;
}

.aw-status--idle {
    border-color: var(--unity-colors-default-border);
}

.aw-status--idle .aw-status-dot {
    background-color: rgb(140, 140, 140);
}

.aw-status--busy {
    border-color: rgb(80, 150, 230);
    background-color: rgba(80, 150, 230, 0.12);
}

.aw-status--busy .aw-status-dot {
    background-color: rgb(80, 150, 230);
}

.aw-status--ok {
    border-color: rgb(70, 180, 100);
    background-color: rgba(70, 180, 100, 0.12);
}

.aw-status--ok .aw-status-dot {
    background-color: rgb(70, 180, 100);
}

.aw-status--error {
    border-color: rgb(220, 80, 70);
    background-color: rgba(220, 80, 70, 0.12);
}

.aw-status--error .aw-status-dot {
    background-color: rgb(220, 80, 70);
}

/* ---------- 기기 목록 ---------- */
.aw-device {
    flex-direction: row;
    align-items: center;
    padding: 6px 0;
    border-bottom-width: 1px;
    border-color: var(--unity-colors-default-border);
}

.aw-device-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin: 0 8px 0 2px;
    background-color: rgb(70, 180, 100);
}

.aw-device-dot--offline {
    background-color: rgb(220, 80, 70);
}

.aw-device-info {
    flex-grow: 1;
    flex-shrink: 1;
}

.aw-device-model {
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

.aw-device-badge {
    font-size: 10px;
    padding: 1px 6px;
    margin-right: 6px;
    border-radius: 8px;
    background-color: rgba(128, 128, 128, 0.25);
}

/* ---------- 로그 ---------- */
.aw-log {
    max-height: 200px;
    min-height: 80px;
    padding: 4px 6px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.2);
}

.aw-log-text {
    white-space: normal;
}
