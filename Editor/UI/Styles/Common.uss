/* 레이아웃·컴포넌트. 색은 모두 Themes/*.uss의 --aw-* 토큰을 쓴다. */

/* ---------- 창 ---------- */
.aw-shell {
    flex-grow: 1;
    -unity-font-definition: url("../Fonts/IBMPlexSansKR-Regular.ttf");
    background-color: var(--aw-bg);
    color: var(--aw-fg);
    font-size: 13px;
}

.aw-shell .unity-label {
    margin: 0;
    padding: 0;
    color: var(--aw-fg);
}

.aw-content {
    flex-grow: 1;
}

.aw-overlay-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.aw-view {
    flex-grow: 1;
}

.aw-page {
    flex-grow: 1;
    padding: 18px 20px 16px 20px;
}

.aw-heading.unity-label {
    font-size: 24px;
    margin-bottom: 10px;
    white-space: normal;
}

.aw-subheading.unity-label {
    white-space: normal;
    margin-bottom: 16px;
}

.aw-has-link {
    --aw-label-link: var(--aw-link);
}

.aw-has-link--hover {
    cursor: link;
}

/* ---------- 버튼 ---------- */
/* 창 안의 모든 버튼(탭·페어링·설치·닫기·X 등)은 링크 커서 */
.aw-shell .unity-button {
    cursor: link;
}

.aw-btn.unity-button {
    margin: 0;
    height: 32px;
    padding: 0 14px;
    border-radius: 6px;
    border-width: 1px;
    font-size: 13px;
    -unity-text-align: middle-center;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.aw-btn--secondary.unity-button {
    background-color: var(--aw-button-bg);
    border-color: var(--aw-button-border);
    color: var(--aw-fg);
}

.aw-btn--secondary.unity-button:hover {
    background-color: var(--aw-button-hover);
}

.aw-btn--secondary.unity-button:active {
    background-color: var(--aw-button-pressed);
}

.aw-btn--primary.unity-button {
    min-width: 88px;
    background-color: var(--aw-accent);
    border-color: var(--aw-accent);
    color: var(--aw-accent-fg);
}

.aw-btn--primary.unity-button:hover {
    background-color: var(--aw-accent-hover);
    border-color: var(--aw-accent-hover);
}

.aw-btn__label.unity-label {
    color: var(--aw-fg);
}

/* ---------- 하단 ---------- */
.aw-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 14px;
    flex-shrink: 0;
}

.aw-footer__note.unity-label {
    flex-shrink: 1;
    margin-right: 12px;
    font-size: 12px;
    white-space: normal;
    color: var(--aw-fg-muted);
}

/* ---------- 기기 목록: 안내 ---------- */
.aw-steps {
    margin-bottom: 4px;
    flex-shrink: 0;
}

.aw-step {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.aw-step__icon {
    width: 26px;
    height: 26px;
    margin: 0 20px 0 6px;
    flex-shrink: 0;
    color: var(--aw-fg-muted);
}

.aw-icon--green {
    color: var(--aw-green);
}

.aw-step__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.aw-step__title.unity-label {
    font-size: 14px;
    -unity-font-definition: url("../Fonts/AwSansKR-Bold.ttf");
    -unity-font-style: normal;
    white-space: normal;
}

.aw-step__desc.unity-label {
    white-space: normal;
}

/* ---------- 기기 목록: 검색 ---------- */
.aw-search {
    flex-direction: row;
    align-items: center;
    height: 34px;
    padding: 0 10px;
    margin-bottom: 6px;
    flex-shrink: 0;
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--aw-border);
    background-color: var(--aw-field-bg);
}

.aw-search--focused {
    border-width: 2px;
    padding: 0 9px;
    border-color: var(--aw-focus);
}

.aw-search__icon {
    width: 16px;
    height: 16px;
    margin-right: 8px;
    flex-shrink: 0;
    color: var(--aw-fg-muted);
}

.aw-search__field {
    flex-grow: 1;
    margin: 0;
}

.aw-search__field .unity-base-text-field__input {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--aw-fg);
    font-size: 13px;
}

.aw-search__field .unity-base-text-field__input--placeholder,
.aw-search__field .unity-base-text-field__input--placeholder .unity-text-element {
    color: var(--aw-fg-muted);
}

/* ---------- 기기 목록: 표 ---------- */
.aw-table {
    flex-grow: 1;
}

.aw-table__header {
    flex-direction: row;
    align-items: center;
    height: 34px;
    padding: 0 8px;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-color: var(--aw-divider);
}

.aw-table__body {
    flex-grow: 1;
}

.aw-table__row {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding: 0 8px;
    border-radius: 4px;
}

.aw-table__row:hover {
    background-color: var(--aw-row-hover);
}

.aw-col {
    flex-shrink: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.aw-col--name {
    width: 28%;
}

.aw-col--version {
    width: 15%;
    flex-direction: row;
    align-items: center;
}

.aw-col--address {
    width: 26%;
}

.aw-col--api {
    width: 11%;
}

.aw-col--action {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.aw-cell.unity-label {
    padding-right: 8px;
}

/* ADB Wi-Fi 버전 원: v1.0 회색, v2.0 초록 */
.aw-version-dot {
    width: 10px;
    height: 10px;
    margin-right: 8px;
    flex-shrink: 0;
    border-radius: 5px;
    background-color: var(--aw-v1);
}

.aw-version-dot--v2 {
    background-color: var(--aw-v2);
}

.aw-version-dot--unknown {
    border-width: 1px;
    border-color: var(--aw-fg-muted);
    background-color: rgba(0, 0, 0, 0);
}

.aw-pair-button.unity-button {
    width: 100px;
}

.aw-pair-icon {
    width: 20px;
    height: 20px;
    margin-right: 6px;
    color: var(--aw-fg-muted);
    --aw-icon-accent: var(--aw-green);
}

.aw-connected {
    flex-direction: row;
    align-items: center;
    height: 32px;
    padding: 0 14px;
}


.aw-connected__label.unity-label {
    color: var(--aw-success);
}

/* ---------- 빈 상태 ---------- */
.aw-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.aw-empty__spinner {
    width: 22px;
    height: 22px;
    margin-bottom: 12px;
    color: var(--aw-fg-muted);
}

.aw-empty__title.unity-label {
    font-size: 14px;
    -unity-font-definition: url("../Fonts/AwSansKR-Bold.ttf");
    -unity-font-style: normal;
    margin-bottom: 6px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.aw-empty__desc.unity-label {
    max-width: 420px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--aw-fg-muted);
}

.aw-empty__button.unity-button {
    margin-top: 14px;
}

/* ---------- Pair 화면: 탭 ---------- */
.aw-tabbox {
    flex-grow: 1;
    border-width: 1px;
    border-color: var(--aw-box-border);
    background-color: var(--aw-box-bg);
}

.aw-tabbar {
    flex-direction: row;
    padding: 10px;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-color: var(--aw-box-border);
}

.aw-tab.unity-button {
    margin: 0 8px 0 0;
    height: 34px;
    padding: 0 14px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    color: var(--aw-fg);
    font-size: 13px;
}

.aw-tab.unity-button:hover {
    background-color: var(--aw-tab-hover);
}

.aw-tab--selected.unity-button,
.aw-tab--selected.unity-button:hover {
    border-color: var(--aw-tab-selected-border);
    background-color: var(--aw-tab-selected-bg);
}

.aw-tabbox__content {
    flex-grow: 1;
}

.aw-tabpage {
    flex-grow: 1;
    align-items: center;
    padding: 20px 16px;
}

.aw-tabpage__caption.unity-label {
    margin-bottom: 18px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.aw-tabpage__spacer {
    flex-grow: 1;
}

.aw-tabpage__hint-title.unity-label {
    margin-top: 16px;
    -unity-font-definition: url("../Fonts/AwSansKR-Bold.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    white-space: normal;
}

.aw-tabpage__hint.unity-label {
    margin-top: 4px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- QR 탭 ---------- */
.aw-qr {
    width: 252px;
    height: 252px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(255, 255, 255);
}

.aw-qr__image {
    width: 244px;
    height: 244px;
}

.aw-qr__image--stale {
    opacity: 0.2;
}

.aw-qr__busy {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background-color: rgba(255, 255, 255, 0.9);
}

.aw-qr__spinner {
    width: 26px;
    height: 26px;
    margin-bottom: 10px;
    color: rgb(90, 90, 90);
}

.aw-shell .aw-qr__busy-text.unity-label {
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgb(30, 30, 30);
}

.aw-inline-error {
    align-items: center;
    margin-top: 14px;
}

.aw-inline-error__text.unity-label {
    max-width: 440px;
    margin-bottom: 8px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--aw-danger);
}

/* ---------- 페어링 코드 탭 ---------- */
.aw-code-tab {
    align-items: stretch;
    padding: 0 0 20px 0;
}

.aw-waiting {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.aw-waiting__text.unity-label {
    margin-bottom: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.aw-waiting__spinner {
    width: 20px;
    height: 20px;
    color: var(--aw-fg-muted);
}

.aw-available {
    flex-grow: 1;
}

.aw-available__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    border-bottom-width: 1px;
    border-color: var(--aw-box-border);
}

.aw-available__title.unity-label {
    -unity-font-definition: url("../Fonts/AwSansKR-Bold.ttf");
    -unity-font-style: normal;
}

.aw-available__spinner {
    width: 16px;
    height: 16px;
    color: var(--aw-fg-muted);
}

.aw-available__list {
    flex-grow: 1;
}

.aw-available__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
}

.aw-available__row:hover {
    background-color: var(--aw-row-hover);
}

.aw-available__address.unity-label {
    font-size: 14px;
}

.aw-available__sub.unity-label {
    margin-top: 2px;
    font-size: 12px;
    color: var(--aw-fg-muted);
}

/* ---------- 6자리 입력 오버레이 ---------- */
.aw-overlay-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.aw-overlay {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: var(--aw-dim);
}

.aw-dialog {
    width: 460px;
    max-width: 92%;
    padding: 26px 24px 18px 24px;
    align-items: center;
    border-width: 1px;
    border-radius: 10px;
    border-color: var(--aw-dialog-border);
    background-color: var(--aw-dialog-bg);
}

.aw-dialog__message.unity-label {
    margin-bottom: 20px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.aw-code-input {
    flex-direction: row;
    justify-content: center;
}

.aw-digit {
    width: 40px;
    height: 46px;
    margin: 0 4px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--aw-border);
    background-color: var(--aw-field-bg);
}

.aw-digit:hover {
    border-color: var(--aw-fg-muted);
}

.aw-digit:focus {
    border-width: 2px;
    border-color: var(--aw-focus);
}

.aw-digit__label.unity-label {
    font-size: 20px;
    -unity-text-align: middle-center;
}

.aw-code-input--error .aw-digit {
    border-color: var(--aw-danger);
}

.aw-code-input:disabled {
    opacity: 0.5;
}

.aw-dialog__status {
    min-height: 42px;
    align-self: stretch;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
}

.aw-dialog__busy {
    flex-direction: row;
    align-items: center;
}

.aw-dialog__spinner {
    width: 16px;
    height: 16px;
    margin-right: 8px;
    color: var(--aw-fg-muted);
}

.aw-dialog__error.unity-label {
    white-space: normal;
    -unity-text-align: middle-center;
    color: var(--aw-danger);
}

.aw-dialog__hint.unity-label {
    font-size: 12px;
    color: var(--aw-fg-muted);
}

.aw-dialog__buttons {
    flex-direction: row;
    justify-content: flex-end;
    align-self: stretch;
    margin-top: 6px;
}

/* ---------- 결과 ---------- */
.aw-result__center {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.aw-result__check {
    width: 120px;
    height: 120px;
    margin-bottom: 26px;
    color: var(--aw-success);
}

.aw-result__title.unity-label {
    font-size: 16px;
    -unity-font-definition: url("../Fonts/AwSansKR-Bold.ttf");
    -unity-font-style: normal;
    margin-bottom: 18px;
}

.aw-result__link.unity-label {
    font-size: 14px;
}

/* ---------- 테마 선택 ---------- */
.aw-setup__scroll {
    flex-grow: 1;
}

.aw-setup__grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.aw-card {
    cursor: link;
    width: 49%;
    margin-bottom: 10px;
    padding: 8px;
    border-width: 2px;
    border-radius: 10px;
    border-color: rgba(0, 0, 0, 0);
}

.aw-card:hover {
    background-color: var(--aw-row-hover);
}

.aw-card--selected,
.aw-card--selected:hover {
    border-color: var(--aw-focus);
}

.aw-card__preview {
    height: 132px;
    padding: 10px;
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--aw-border);
    background-color: var(--aw-bg);
}

.aw-card__title {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
}

/* Android Studio: 아이콘 + 굵은 이름. Unity 워드마크(높이 22px)와 무게를 맞춘다 */
.aw-card__icon {
    width: 24px;
    height: 24px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.aw-card__label.unity-label {
    font-size: 14px;
    -unity-font-definition: url("../Fonts/AwSansKR-Bold.ttf");
    -unity-text-align: middle-center;
}

/* Unity 워드마크 (원본 1157×403) */
.aw-card__logo {
    width: 63px;
    height: 22px;
    -unity-background-scale-mode: scale-to-fit;
}

.aw-mini__search {
    height: 16px;
    margin-bottom: 8px;
    border-width: 1px;
    border-radius: 3px;
    border-color: var(--aw-focus);
    background-color: var(--aw-field-bg);
}

.aw-mini__row {
    flex-direction: row;
    align-items: center;
    height: 26px;
    border-bottom-width: 1px;
    border-color: var(--aw-divider);
}

.aw-mini__text {
    width: 28%;
    height: 6px;
    margin-right: 8%;
    border-radius: 3px;
    background-color: var(--aw-fg);
    opacity: 0.7;
}

.aw-mini__text--short {
    width: 16%;
}

.aw-mini__dot {
    width: 8px;
    height: 8px;
    margin-right: 8%;
    border-radius: 4px;
    background-color: var(--aw-v1);
}

.aw-mini__dot.aw-version-dot--v2 {
    background-color: var(--aw-v2);
}

.aw-mini__button {
    margin-left: auto;
    width: 34px;
    height: 16px;
    border-width: 1px;
    border-radius: 4px;
    border-color: var(--aw-button-border);
    background-color: var(--aw-button-bg);
}

.aw-mini__footer {
    flex-grow: 1;
    flex-direction: row;
    justify-content: flex-end;
    align-items: flex-end;
}

.aw-mini__primary {
    width: 40px;
    height: 16px;
    border-radius: 4px;
    background-color: var(--aw-accent);
}


/* ---------- Platform-Tools 업데이트 배너 ---------- */
.aw-banner {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 12px;
    padding: 8px 10px 8px 14px;
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--aw-tab-selected-border);
    background-color: var(--aw-tab-selected-bg);
}

.aw-banner__text.unity-label {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 10px;
    white-space: nowrap;
    /* 버튼 영역을 넘어가지 않도록 칸 밖의 글자는 잘라낸다 */
    min-width: 0;
    overflow: hidden;
    /* 한 줄을 유지하고, 넘치면 글자를 줄인다 (Best Fit) */
    -unity-text-auto-size: best-fit 9px 13px;
}

.aw-banner--error .aw-banner__text.unity-label {
    color: var(--aw-danger);
}

.aw-banner__spinner {
    width: 16px;
    height: 16px;
    margin-right: 6px;
    color: var(--aw-fg-muted);
}

.aw-banner__button.unity-button {
    height: 28px;
    margin-left: 6px;
}

.aw-banner__close.unity-button {
    width: 26px;
    height: 26px;
    margin: 0 0 0 6px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 0;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0);
}

.aw-banner__close.unity-button:hover {
    background-color: var(--aw-tab-hover);
}

.aw-banner__close-icon {
    width: 14px;
    height: 14px;
    color: var(--aw-fg-muted);
}

.aw-banner__close.unity-button:hover .aw-banner__close-icon {
    color: var(--aw-fg);
}

/* ---------- Android 모듈 없음 ---------- */
.aw-missing__center {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.aw-missing__title.unity-label {
    font-size: 16px;
    -unity-font-definition: url("../Fonts/AwSansKR-Bold.ttf");
    margin-bottom: 10px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.aw-missing__desc.unity-label {
    max-width: 460px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--aw-fg-muted);
}
