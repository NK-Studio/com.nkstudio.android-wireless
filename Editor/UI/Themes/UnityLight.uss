/* Unity — Light (Unity 6 editor light skin). 색 토큰만 정의한다 — 레이아웃은 Styles/Common.uss */
:root {
    --aw-bg: #C8C8C8;
    --aw-fg: #090909;
    --aw-fg-muted: #505050;
    --aw-divider: #B0B0B0;
    --aw-border: #999999;
    --aw-field-bg: #F0F0F0;
    --aw-focus: #3A72B0;
    --aw-accent: #3A72B0;
    --aw-accent-hover: #4682C4;
    --aw-accent-fg: #FFFFFF;
    --aw-link: #1C4FC2;
    --aw-row-hover: #BBBBBB;
    --aw-button-bg: #E4E4E4;
    --aw-button-border: #B2B2B2;
    --aw-button-hover: #ECECEC;
    --aw-button-pressed: #96C3FB;
    --aw-tab-selected-bg: #B9CDE6;
    --aw-tab-selected-border: #3A72B0;
    --aw-tab-hover: #BBBBBB;
    --aw-box-bg: #CBCBCB;
    --aw-box-border: #999999;
    --aw-green: #2E7D32;
    --aw-success: #3E9A4A;
    --aw-danger: #C0392B;
    --aw-v1: #7A7A7A;
    --aw-v2: #2E9E44;
    --aw-dim: rgba(0, 0, 0, 0.35);
    --aw-dialog-bg: #D6D6D6;
    --aw-dialog-border: #8A8A8A;
}
