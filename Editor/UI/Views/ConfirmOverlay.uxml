<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="dim" class="aw-overlay">
        <ui:VisualElement name="dialog" class="aw-dialog aw-dialog--confirm">
            <ui:Label name="title" class="aw-dialog__title" />
            <ui:Label name="body" class="aw-dialog__text" />
            <ui:VisualElement class="aw-dialog__buttons">
                <ui:Button name="cancel" text="@common.cancel" class="aw-btn aw-btn--secondary" />
                <ui:Button name="confirm" class="aw-btn aw-btn--primary aw-dialog__confirm" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
